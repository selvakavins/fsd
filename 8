import { useState } from "react";
import "./App.css";
function App() {
const [candidateA, setCandidateA] = useState(0);
const [candidateB, setCandidateB] = useState(0);
const [candidateC, setCandidateC] = useState(0);
return (
<div className="container">
<h1>Voting Application</h1>
<div className="card">
<h2>Candidate A</h2>
<p>Votes: {candidateA}</p>
<button onClick={() => setCandidateA(candidateA + 1)}>
Vote
</button>
</div>
<div className="card">
<h2>Candidate B</h2>
<p>Votes: {candidateB}</p>
<button onClick={() => setCandidateB(candidateB + 1)}>
Vote
</button>
</div>
<div className="card">
<h2>Candidate C</h2>
<p>Votes: {candidateC}</p>
<button onClick={() => setCandidateC(candidateC + 1)}>
Vote
</button>
</div>
</div>
);
}
export default App;

